# Server-side only. Copy to .env.local, configure at least one provider, no quotes.
# Enables Google Gemini
GEMINI_API_KEY=
# Alternative Gemini key, used only when GEMINI_API_KEY is empty
GOOGLE_GENERATIVE_AI_API_KEY=
# Enables DeepSeek
DEEPSEEK_API_KEY=
# Enables Anthropic Claude
ANTHROPIC_API_KEY=
# Enables OpenAI
OPENAI_API_KEY=
# OpenAI-compatible endpoint base URL (enabled together with OPENAI_COMPATIBLE_MODELS)
OPENAI_COMPATIBLE_BASE_URL=
# Comma-separated model IDs for the OpenAI-compatible endpoint (first = default)
OPENAI_COMPATIBLE_MODELS=
# Optional API key for the OpenAI-compatible endpoint
OPENAI_COMPATIBLE_API_KEY=
# Optional display name for the OpenAI-compatible provider
OPENAI_COMPATIBLE_NAME=
# Optional preferred default provider: gemini | deepseek | anthropic | openai | openai-compatible
LLM_PROVIDER=
# Optional default model for the default provider
LLM_MODEL=
# Optional comma-separated Gemini model IDs replacing the built-in list (first = default)
GEMINI_MODELS=
# Optional comma-separated DeepSeek model IDs replacing the built-in list (first = default)
DEEPSEEK_MODELS=
# Optional comma-separated Anthropic model IDs replacing the built-in list (first = default)
ANTHROPIC_MODELS=
# Optional comma-separated OpenAI model IDs replacing the built-in list (first = default)
OPENAI_MODELS=
# Optional max /api/coach requests per 10 minutes (default 30; use 200 for evals)
RATE_LIMIT_MAX=
# Optional: 1 = trust X-Forwarded-For / X-Real-IP for per-IP rate limiting
TRUST_PROXY=
# Set automatically by Vercel (1 = per-IP rate limiting); leave empty elsewhere
VERCEL=
# npm run eval: base URL of the running app (default http://localhost:3000)
EVAL_BASE_URL=
# npm run eval: optional provider to request
EVAL_PROVIDER=
# npm run eval: optional model to request
EVAL_MODEL=
