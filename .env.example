# Server-side only. Copy to .env.local and fill in at least one key.
# A provider is enabled when its key is non-empty.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alias accepted for Gemini if GEMINI_API_KEY is empty:
GOOGLE_GENERATIVE_AI_API_KEY=
DEEPSEEK_API_KEY=

# Optional: preferred default provider (gemini | deepseek | anthropic)
LLM_PROVIDER=
# Optional: default model for the default provider
LLM_MODEL=

# Optional: comma-separated lists that REPLACE the curated model list
# (first entry = default)
ANTHROPIC_MODELS=
GEMINI_MODELS=
DEEPSEEK_MODELS=
