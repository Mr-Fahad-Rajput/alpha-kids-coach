# Server-side only. Copy to .env.local, fill in at least one provider key, no quotes.
# Enables Anthropic Claude
ANTHROPIC_API_KEY=
# Enables Google Gemini
GEMINI_API_KEY=
# Alternative Gemini key, used only when GEMINI_API_KEY is empty
GOOGLE_GENERATIVE_AI_API_KEY=
# Enables DeepSeek
DEEPSEEK_API_KEY=
# Optional preferred default provider: gemini | deepseek | anthropic
LLM_PROVIDER=
# Optional default model for the default provider
LLM_MODEL=
# Optional comma-separated Anthropic model IDs replacing the built-in list (first = default)
ANTHROPIC_MODELS=
# Optional comma-separated Gemini model IDs replacing the built-in list (first = default)
GEMINI_MODELS=
# Optional comma-separated DeepSeek model IDs replacing the built-in list (first = default)
DEEPSEEK_MODELS=
